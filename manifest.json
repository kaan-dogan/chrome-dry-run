{
  "manifest_version": 3,
  "name": "Dry Run",
  "version": "2.0.0",
  "description": "Bir ogeye sag tikla, 'Dry run' sec: basarsan ne gidecegini gosterir, istek gitmez.",
  "permissions": ["contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ]
}
